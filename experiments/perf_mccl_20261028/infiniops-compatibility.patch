 function(_infiniops_configure_infinirt)
+    # AUTO_FALLBACK_INFINI_RT_SOURCE: cmake may wipe -D cache when CMAKE_CXX_COMPILER changes mid-configure.
+    if(NOT INFINI_RT_SOURCE_DIR AND NOT INFINI_RT_ROOT)
+        set(_sibling_rt "${CMAKE_CURRENT_LIST_DIR}/../InfiniRT")
+        if(EXISTS "${_sibling_rt}/CMakeLists.txt")
+            set(INFINI_RT_SOURCE_DIR "${_sibling_rt}")
+            message(STATUS "Auto-selected InfiniRT source: ${INFINI_RT_SOURCE_DIR}")
+        endif()
+    endif()
+
     if(TARGET infinirt)
         get_target_property(_infinirt_include_dirs infinirt INTERFACE_INCLUDE_DIRECTORIES)
         if(_infinirt_include_dirs)
